# Handle line endings automatically for files detected as text and leave binary files untouched.
* text=auto

# scripts that run on Linux and macOS must keep Unix line endings
*.sh text eol=lf
packaging/linux/AppRun text eol=lf
*.rs text eol=lf
*.toml text eol=lf

# Windows scripts
*.ps1 text eol=crlf
*.iss text eol=crlf

*.png binary
*.ico binary
*.icns binary
*.jar binary
*.bmp binary
*.bat text eol=crlf
