#!/bin/sh
# postinst script for APPLICATION_PACKAGE
#
# jpackage fills in the words in capitals. This replaces its own postinst so that a system without a desktop menu
# (minimal installs, containers, WSL) can still install the package: there xdg-desktop-menu stops with "No writable
# system menu directory found", and jpackage's own postinst would then fail the whole install.

set -e

# read by the scripts jpackage puts in below
# shellcheck disable=SC2034
package_type=deb
LAUNCHER_AS_SERVICE_SCRIPTS

add_menu_entry () {
    :
DESKTOP_COMMANDS_INSTALL
}

case "$1" in
    configure)
        add_menu_entry || echo "APPLICATION_PACKAGE: couldn't add the menu entry, the program is installed anyway" >&2
LAUNCHER_AS_SERVICE_COMMANDS_INSTALL
    ;;

    abort-upgrade|abort-remove|abort-deconfigure)
    ;;

    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

exit 0
