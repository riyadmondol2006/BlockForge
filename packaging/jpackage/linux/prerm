#!/bin/sh
# prerm script for APPLICATION_PACKAGE
#
# jpackage fills in the words in capitals. This replaces its own prerm so that removing the menu entry can't block
# uninstalling or upgrading the package (see postinst).

set -e

# read by the scripts jpackage puts in below
# shellcheck disable=SC2034
package_type=deb
DESKTOP_SCRIPTS
LAUNCHER_AS_SERVICE_SCRIPTS

remove_menu_entry () {
    :
DESKTOP_COMMANDS_UNINSTALL
}

case "$1" in
    remove|upgrade|deconfigure)
        remove_menu_entry || echo "APPLICATION_PACKAGE: couldn't remove the menu entry" >&2
LAUNCHER_AS_SERVICE_COMMANDS_UNINSTALL
    ;;

    failed-upgrade)
    ;;

    *)
        echo "prerm called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

exit 0
